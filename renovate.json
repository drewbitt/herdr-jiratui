{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "timezone": "America/New_York",
  "schedule": ["* * 1,15 * *"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * 1,15 * *"]
  },
  "packageRules": [
    {
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "matchPackageNames": ["jiratui"],
      "groupName": null
    }
  ]
}
